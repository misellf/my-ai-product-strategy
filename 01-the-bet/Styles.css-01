:root {
  --bg: #0b1020;
  --panel: #131a2b;
  --panel-2: #1a2338;
  --text: #e8ecf7;
  --muted: #9ea8c7;
  --primary: #7c9cff;
  --primary-2: #5f84ff;
  --success: #35d07f;
  --danger: #ff6b81;
  --warning: #ffcc66;
  --border: #2a3452;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  background: radial-gradient(1200px 800px at 20% -10%, #1b2550 0%, var(--bg) 45%);
  color: var(--text);
}

.app {
  max-width: 1100px;
  margin: 24px auto;
  padding: 0 16px 24px;
  display: grid;
  gap: 16px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 16px;
  padding: 16px 4px;
}

h1 {
  margin: 0;
  font-size: 1.8rem;
}

.subtitle {
  margin: 6px 0 0;
  color: var(--muted);
}

.badge {
  border: 1px solid var(--border);
  background: #0f1528;
  color: var(--muted);
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 0.82rem;
}

.panel {
  background: linear-gradient(180deg, var(--panel), var(--panel-2));
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
}

.panel h2 {
  margin-top: 4px;
  margin-bottom: 14px;
  font-size: 1.1rem;
}

.grid.two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.field {
  margin-bottom: 14px;
}

label {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 0.92rem;
}

input,
select,
textarea,
button {
  font: inherit;
}

select,
textarea {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #0f1528;
  color: var(--text);
  padding: 10px 12px;
  outline: none;
}

textarea {
  resize: vertical;
  min-height: 96px;
}

.segmented {
  display: inline-flex;
  background: #0f1528;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 4px;
  gap: 4px;
}

.seg {
  border: none;
  background: transparent;
  color: var(--muted);
  padding: 8px 12px;
  border-radius: 8px;
  cursor: pointer;
}

.seg.active {
  background: #212d49;
  color: var(--text);
}

.checks {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 8px;
}

.checks label {
  margin: 0;
  display: flex;
  gap: 8px;
  align-items: center;
  background: #0f1528;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 9px 10px;
  color: var(--text);
}

.cta {
  border: none;
  background: linear-gradient(135deg, var(--primary), var(--primary-2));
  color: white;
  font-weight: 600;
  padding: 11px 14px;
  border-radius: 10px;
  cursor: pointer;
}

.empty {
  color: var(--muted);
  border: 1px dashed var(--border);
  border-radius: 10px;
  padding: 14px;
}

.result-card {
  display: grid;
  gap: 12px;
}

.kpis {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.kpi {
  border: 1px solid var(--border);
  background: #0f1528;
  border-radius: 10px;
  padding: 8px 10px;
  font-size: 0.9rem;
  color: var(--muted);
}

.status {
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 999px;
  margin-left: 6px;
  display: inline-block;
}

.status.validated {
  color: #04150c;
  background: var(--success);
}

.status.invalidated {
  color: #2b0810;
  background: var(--danger);
}

.card {
  border: 1px solid var(--border);
  background: #0f1528;
  border-radius: 12px;
  padding: 12px;
}

.card h3 {
  margin-top: 0;
  margin-bottom: 8px;
  font-size: 1rem;
}

.list {
  margin: 0;
  padding-left: 18px;
  color: #d9e2ff;
}

.priority {
  display: inline-flex;
  padding: 3px 8px;
  border-radius: 999px;
  font-size: 0.78rem;
  margin-left: 6px;
  border: 1px solid transparent;
}

.p1 { background: rgba(255, 107, 129, 0.15); color: #ff9bad; border-color: rgba(255, 107, 129, 0.35);}
.p2 { background: rgba(255, 204, 102, 0.16); color: #ffd88f; border-color: rgba(255, 204, 102, 0.4);}
.p3 { background: rgba(53, 208, 127, 0.16); color: #8de8b7; border-color: rgba(53, 208, 127, 0.4);}

.small {
  color: var(--muted);
  font-size: 0.86rem;
}

@media (max-width: 760px) {
  .grid.two {
    grid-template-columns: 1fr;
  }
}
